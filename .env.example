# =============================================================================
# QueryPilot AI — Environment Configuration
# Copy to .env and fill in values
# =============================================================================

# Application
APP_NAME=QueryPilot AI
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173

# Application Database (internal persistence)
APP_DATABASE_URL=postgresql+psycopg://querypilot:querypilot_dev@localhost:5433/querypilot_app

# Default Target Database (for demo/evaluation)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5433
TARGET_DB_NAME=querypilot_target
TARGET_DB_USER=target_readonly
TARGET_DB_PASSWORD=target_readonly_dev

# LLM / Inference
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=120

# Query Safety
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=30000
SQL_MAX_QUERY_LENGTH=4096

# Auth (simplified for hackathon)
AUTH_ENABLED=false
AUTH_DEFAULT_USER=demo
AUTH_JWT_SECRET=change-me-jwt-secret
AUTH_JWT_EXPIRY_HOURS=24
